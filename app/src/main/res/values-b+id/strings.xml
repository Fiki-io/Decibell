    <!-- Info Dialog Descriptions -->
    <string name="info_title_size">Ukuran Slider</string>
    <string name="info_desc_size">Mengatur tinggi vertikal jalur slider equalizer agar pengaturan gain lebih presisi.</string>
    <string name="info_title_visualizer">Visualizer Spektrum</string>
    <string name="info_desc_visualizer">Menangkap data frekuensi FFT waktu nyata dari sesi audio aktif. Membutuhkan izin mikrofon sesuai aturan Android Visualizer API.</string>
    <string name="info_title_bass_boost">Bass Boost</string>
    <string name="info_desc_bass_boost">Memperkuat respons frekuensi rendah melalui mesin efek audio perangkat.</string>
    <string name="info_title_3d_sound">Virtualizer Suara 3D</string>
    <string name="info_desc_3d_sound">Memperluas pemisahan stereo dan ruang panggung suara pada kanal kiri dan kanan.</string>
    <string name="info_title_auto_pan">Auto-Pan Stereo</string>
    <string name="info_desc_auto_pan">Memodulasi pre-gain kanal kiri dan kanan secara berkala sesuai frekuensi yang dipilih.</string>
    <string name="info_title_mbc">Multi-band Compressor</string>
    <string name="info_desc_mbc">Mengompresi rentang dinamis per pita frekuensi secara independen untuk mencegah distorsi speaker dan menyeimbangkan energi suara.</string>
    <string name="info_title_limiter">Limiter Output</string>
    <string name="info_desc_limiter">Mencegah kliping digital dengan menahan puncak sinyal di atas ambang batas pada tahap akhir DynamicsProcessing.</string>
    <string name="info_title_eq_config">Konfigurasi Frekuensi Cut-off</string>
    <string name="info_desc_eq_config">Menentukan batas frekuensi atas dalam Hz untuk setiap band pada DynamicsProcessing. Nilai wajib naik berurutan dari band 1 hingga akhir (20 Hz s/d 20000 Hz).</string>

    <!-- Permission Rationale Dialog -->
    <string name="title_permission_visualizer">Izin Tangkapan Audio</string>
    <string name="desc_permission_visualizer">Android mewajibkan izin RECORD_AUDIO untuk membaca spektrum FFT pada visualizer. Pemrosesan suara equalizer tetap berfungsi tanpa izin ini.</string>
