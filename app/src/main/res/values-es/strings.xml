    <!-- Info Dialog Descriptions -->
    <string name="info_title_size">Tamaño del control</string>
    <string name="info_desc_size">Ajusta la altura vertical de las bandas del ecualizador para un control más preciso.</string>
    <string name="info_title_visualizer">Visualizador de espectro</string>
    <string name="info_desc_visualizer">Captura datos de frecuencia FFT en tiempo real de la sesión activa. Requiere permiso de audio exigido por la API Visualizer de Android.</string>
    <string name="info_title_bass_boost">Refuerzo de graves</string>
    <string name="info_desc_bass_boost">Amplifica la respuesta de baja frecuencia mediante el motor de audio del dispositivo.</string>
    <string name="info_title_3d_sound">Virtualizador 3D</string>
    <string name="info_desc_3d_sound">Amplía la separación estéreo y el espacio acústico entre los canales.</string>
    <string name="info_title_auto_pan">Auto-Pan estéreo</string>
    <string name="info_desc_auto_pan">Modula periódicamente la ganancia de los canales izquierdo y derecho.</string>
    <string name="info_title_mbc">Compresor multibanda</string>
    <string name="info_desc_mbc">Comprime el rango dinámico por banda de frecuencia para evitar distorsión y equilibrar la energía tonal.</string>
    <string name="info_title_limiter">Limitador de salida</string>
    <string name="info_desc_limiter">Evita el recorte digital restringiendo los picos por encima del umbral en la etapa final.</string>
    <string name="info_title_eq_config">Frecuencia de corte</string>
    <string name="info_desc_eq_config">Define la frecuencia de corte superior en Hz para cada banda en DynamicsProcessing (20 Hz a 20000 Hz en orden ascendente). Frecuencia central = (Corte inferior + Corte superior) / 2. Fórmula: Corte = (2 x Hz Objetivo) - Corte anterior.</string>
    <string name="desc_cutoff_formula">Fórmula: Corte = (2 x Hz Objetivo) - Corte anterior (Ej.: 60 Hz desde 0 -> ingrese 120).</string>
