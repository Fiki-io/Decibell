    <!-- Info Dialog Descriptions -->
    <string name="info_title_size">Slider Size</string>
    <string name="info_desc_size">Adjusts the vertical height of the equalizer fader tracks for finer gain control.</string>
    <string name="info_title_visualizer">Spectrum Visualizer</string>
    <string name="info_desc_visualizer">Captures real-time FFT frequency data from the active audio session. Requires microphone permission mandated by Android Visualizer API.</string>
    <string name="info_title_bass_boost">Bass Boost</string>
    <string name="info_desc_bass_boost">Amplifies low-frequency response using the hardware audio effect engine.</string>
    <string name="info_title_3d_sound">3D Sound Virtualizer</string>
    <string name="info_desc_3d_sound">Widens stereo separation and spatial soundstage across stereo channels.</string>
    <string name="info_title_auto_pan">Stereo Auto-Pan</string>
    <string name="info_desc_auto_pan">Modulates left and right channel pre-gain periodically at the selected frequency.</string>
    <string name="info_title_mbc">Multi-band Compressor</string>
    <string name="info_desc_mbc">Compresses dynamic range independently per frequency band to prevent speaker distortion and balance tonal energy.</string>
    <string name="info_title_limiter">Output Limiter</string>
    <string name="info_desc_limiter">Prevents digital clipping by restricting peaks above the threshold at the final stage of DynamicsProcessing.</string>
    <string name="info_title_eq_config">Cut-off Frequency Configuration</string>
    <string name="info_desc_eq_config">Defines the upper cut-off frequency in Hz for each band in DynamicsProcessing (20 Hz to 20000 Hz ascending). Slider center frequency = (Lower Cut-off + Upper Cut-off) / 2. To target a specific center Hz: Cut-off = (2 x Target Hz) - Previous Cut-off.</string>
    <string name="desc_cutoff_formula">Formula: Cut-off = (2 x Target Hz) - Prev Cut-off (e.g. Target 60 Hz from 0 -> enter 120).</string>
    <string name="col_center_preview">Slider Hz</string>
    <string name="format_center_single">%1$d Hz (%2$d-%3$d)</string>
    <string name="format_center_dual">L:%1$d / R:%2$d Hz</string>

